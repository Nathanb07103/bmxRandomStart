#include <LiquidCrystal_I2C.h>
#include <PCM.h>
#include "audio.h"  // audio file converted from .WAV to a C++ array via online WAV2c converter https://guilhermerodrigues680.github.io/wav2c-online/ 
#include <Wire.h>

LiquidCrystal_I2C lcd(0x27, 16, 2);

void setup() {
  randomSeed(analogRead(A0));
  pinMode(4, OUTPUT);
  pinMode(5, OUTPUT);
  pinMode(6, OUTPUT);
  pinMode(7, OUTPUT);
  lcd.init();
  lcd.backlight();
}

void loop() {
  startPlayback(sounddata_data, sounddata_length);  // Start of audio
  delay(6000);
  stopPlayback();                                   // End audio
  TCCR2A = _BV(COM2A1) | _BV(COM2B1) | _BV(WGM20);  // Reset for tone
  TCCR2B = _BV(CS22);
  int randomWait = random(100, 2700);
  delay(randomWait);  // Random delay
  tone(11, 632, 60); // Beep 1
  digitalWrite(4, HIGH); // Red light
  delay(120);

  tone(11, 632, 60); // Beep 2
  digitalWrite(5, HIGH); // Yellow light 1
  delay(120);

  tone(11, 632, 60); // Beep 3
  digitalWrite(6, HIGH); // Yellow light 2
  delay(120);

  tone(11, 632, 2250); // Beep 4
  digitalWrite(7, HIGH); // Green light
  
  int startTime = millis();  // Start of reaction timer
  int endTime = 0;
  bool buttonPressed = false;

  while (millis() - startTime < 2500) {
    if (digitalRead(12) == HIGH) {
      endTime = millis();  // End of reaction timer
      buttonPressed = true;
      break;
    }
  }
  lcd.setCursor(0, 0);
  if(buttonPressed) {
    int reactionTime = endTime - startTime;
    lcd.print("Your reaction");
    lcd.setCursor(0, 1);
    lcd.print("time is ");
    lcd.print(reactionTime);
    lcd.print("ms");
  } else {
    lcd.print("Too slow!");
  }
  digitalWrite(4, LOW);
  digitalWrite(5, LOW);
  digitalWrite(6, LOW);
  digitalWrite(7, LOW);
  while(true){}
}
